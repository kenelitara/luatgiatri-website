{
  "name": "luatgiatri-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "migrate": "payload migrate",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "capture": "node scripts/capture-content.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:media": "tsx scripts/seed-media.ts",
    "reindex": "tsx scripts/reindex-search.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/postcss": "4.3.3",
    "graphql": "^16.14.2",
    "next": "16.3.6",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
