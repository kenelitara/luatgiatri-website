# ============================================================
# luatgiatri-website — environment variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env`.
# ============================================================

# --- Public URLs ---
PUBLIC_BASE_URL=https://luatgiatri.com

# --- Database (project-private; remove this block if no DB) ---
# DATABASE_URI host: 127.0.0.1:5432 for host dev (pnpm dev), db:5432 inside
# the compose app service.
POSTGRES_USER=luatgiatri-website
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=luatgiatri-website
DATABASE_URI=postgresql://luatgiatri-website:__POSTGRES_PASSWORD__@db:5432/luatgiatri-website

# --- Payload
# NOTE: POSTGRES_PASSWORD appears in TWO places — its own line and inside
# DATABASE_URI above. Change both together or the app silently loses the DB.
PAYLOAD_SECRET=__CHANGE_ME_32_CHARS__
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ENV=staging
IP_HASH_SALT=__CHANGE_ME__
NEXT_PUBLIC_GA4_ID=

# --- App secrets ---
# Add SESSION_SECRET, JWT_SECRET, API_KEY, etc. as needed.
