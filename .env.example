# --- App
# SITE_ENV / NEXT_PUBLIC_SERVER_URL / NEXT_PUBLIC_GA4_ID are BUILD-TIME values:
# `pnpm build` bakes them in (Docker: passed as build args, see
# docker-compose.vps.yml). Setting them at container runtime does nothing.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ENV=staging
# optional analytics; empty = no GA4 script and no consent banner
NEXT_PUBLIC_GA4_ID=

# --- Payload
PAYLOAD_SECRET=__CHANGE_ME_32_CHARS__
# host dev: 127.0.0.1:5432; in-container (compose app service): db:5432
# (both compose files override this with db:5432 in their environment block)
DATABASE_URI=postgres://luatgiatri:__POSTGRES_PASSWORD__@127.0.0.1:5432/luatgiatri

# --- Postgres container
POSTGRES_USER=luatgiatri
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=luatgiatri

# --- Compliance (used from M3)
IP_HASH_SALT=__CHANGE_ME__